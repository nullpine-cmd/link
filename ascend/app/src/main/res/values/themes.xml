<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Ascend" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ascend_void</item>
        <item name="android:colorBackground">@color/ascend_void</item>
        <item name="android:colorAccent">@color/ascend_violet</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Ascend.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ascend_void</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ascend_icon_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Ascend</item>
    </style>

</resources>
